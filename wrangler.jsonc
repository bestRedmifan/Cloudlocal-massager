{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "Cloudlocal-massager",
  "main": "index.js",
  "compatibility_date": "2026-11-09",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
  {
    "binding": "DB",
    "database_name": "cloudlocal-messages",
    "database_id": "a4bda3df-2b8d-4b57-9ee4-a9ce9f326705"
  }
]
}
